{
  "mesh": {
    "rpc": {
      "env": "local",
      "clientEnabled": true,
      "defaultClientService": {
        "name": "demo-service",
        "host": "localhost",
        "port": 8080
      },
      "clientServices": [
        {
          "name": "demo-service",
          "host": "localhost",
          "port": 8080
        }
      ],
      "clientShutDownTimeout": 10,
      "packetMaxSize": 1048576,
      "keepAliveTimeout": 6,
      "keepAliveInterval": 2,
      "keepAliveIdleTimeout": 10,
      "keepAliveHeartbeatTimeout": 1
    }
  }
}

